# Copia este archivo como .env y cambia los valores si lo necesitas.
# .env no se sube a Git; este archivo de ejemplo sí, para saber qué variables existen.

DB_NAME=bank
DB_USERNAME=bank_user
DB_PASSWORD=bank_dev_password
DB_PORT=5433

# Puertos en tu máquina cuando todo corre con Docker Compose.
# Son distintos a los de desarrollo (backend 8081, frontend 4300) para poder usar ambos a la vez.
BACKEND_PORT=8082
FRONTEND_PORT=8090
